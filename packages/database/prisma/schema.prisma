generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  shifts    Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shift {
  id         String    @id @default(cuid())
  title      String
  startTime  DateTime
  endTime    DateTime
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull )
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId])
  @@index([startTime])
}