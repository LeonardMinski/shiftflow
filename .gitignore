cat > .gitignore <<'EOF'
# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Build output
dist/
build/
coverage/

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
playwright-report/
test-results/

# macOS
.DS_Store

# IDE
.vscode/
.idea/
